import super::shared::*;

struct Solution {
    bid: Bid,
    // whether to use the grace period
    grace: Bool,
}

fn main(
    BID_VERIFIER: BidVerifier,
    TIMINGS: Timings,
    BUYERS_PREMIUM_BPS: Int,
    ROYALTY_BPS: Int,
    Truth: AuctionStateTruth,
    ...{ bid, grace }: Solution,
) -> Output {
    // The bid is stored in the curried state, which must be canonical so that it can be reproduced
    // from the parsed values. Arithmetic always outputs canonical integers, so this strips any
    // redundant leading zeros from the amount.
    let bid = Bid { amount: bid.amount + 0, puzzle_hash: bid.puzzle_hash };

    let old_bid = inline if Truth.state.winning_bid.amount == 0 {
        nil
    } else {
        Truth.state.winning_bid
    };

    // The bid comes from the solution, so its puzzle hash must be checked at runtime. Otherwise a
    // malformed puzzle hash would make every future refund and the NFT transfer invalid.
    //
    // Bids must strictly increase regardless of the verifier. Since the initial winning bid amount
    // is 0, this also ensures that every bid is positive.
    assert !Truth.state.ended
        & (bid.puzzle_hash.length == 32)
        & (bid.amount > Truth.state.winning_bid.amount)
        & BID_VERIFIER(old_bid, bid);

    // The premium and royalty are rounded separately so that the reserve holds exactly what the end
    // action pays out. This matters for CAT reserves, since the CAT ring must balance exactly.
    let reserve_amount = bid.amount
        + calculate_bps_amount(bid.amount, BUYERS_PREMIUM_BPS)
        + calculate_bps_amount(bid.amount, ROYALTY_BPS);

    Output {
        new_truth: AuctionStateTruth {
            state: AuctionState { reserve_amount, ended: false, winning_bid: bid },
            ephemeral_state: Truth.ephemeral_state,
        },
        conditions: [
            // We need to make sure we're either before the grace period ends or before the auction ends
            inline if grace & (TIMINGS.grace_period > 0) {
                AssertBeforeSecondsRelative { seconds: TIMINGS.grace_period }
            } else {
                AssertBeforeSecondsAbsolute { seconds: TIMINGS.end_time }
            },

            // Announce the bid, so that the bidder can assert it in their coin spends
            CreateCoinAnnouncement { message: tree_hash(bid) },

            // If there is a previous bid, we need to refund it in full
            ...inline if Truth.state.winning_bid.amount == 0 {
                []
            } else {
                [ReserveCondition {
                    condition: CreateCoin {
                        puzzle_hash: Truth.state.winning_bid.puzzle_hash,
                        amount: Truth.state.reserve_amount,
                        memos: Memos { value: [Truth.state.winning_bid.puzzle_hash] },
                    },
                }]
            },
        ],
    }
}
