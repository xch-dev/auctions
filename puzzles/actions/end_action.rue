import super::shared::*;

struct Payments {
    buyers_premium: BpsPayment,
    commission: BpsPayment,
    ...payout_puzzle_hash: Bytes32,
}

struct Solution {
    ...unlocker_solution: Any,
}

fn main(
    UNLOCKER: fn(Truth: Bid, ...solution: Any) -> List<NftCondition>,
    TIMINGS: Timings,
    PAYMENTS: Payments,
    ROYALTY_BPS: Int,
    // The inner puzzle hash of the settlement coin, which is wrapped by the CAT layer for CAT reserves
    SETTLEMENT_PAYMENT_HASH: Bytes32,
    NFT_COIN_ID: Bytes32,
    Truth: AuctionStateTruth,
    ...{ unlocker_solution }: Solution,
) -> Output {
    // The NFT can only be unlocked once, so a second end would lock up any funds bid after it
    assert !Truth.state.ended;

    let bid_amount = Truth.state.winning_bid.amount;
    let buyers_premium = calculate_bps_amount(bid_amount, PAYMENTS.buyers_premium.bps);
    let commission = calculate_bps_amount(bid_amount, PAYMENTS.commission.bps);
    let royalty = calculate_bps_amount(bid_amount, ROYALTY_BPS);
    let payout = bid_amount - commission;
    let unlock_conditions = UNLOCKER(Truth.state.winning_bid, ...unlocker_solution);

    Output {
        new_truth: AuctionStateTruth {
            state: AuctionState {
                reserve_amount: 0,
                ended: true,
                winning_bid: Truth.state.winning_bid,
            },
            ephemeral_state: Truth.ephemeral_state,
        },
        conditions: [
            // Pay the buyer's premium
            inline if buyers_premium == 0 {
                Remark {}
            } else {
                ReserveCondition {
                    condition: CreateCoin {
                        puzzle_hash: PAYMENTS.buyers_premium.puzzle_hash,
                        amount: buyers_premium,
                        memos: Memos { value: [PAYMENTS.buyers_premium.puzzle_hash] },
                    },
                }
            },

            // Pay the commission
            inline if commission == 0 {
                Remark {}
            } else {
                ReserveCondition {
                    condition: CreateCoin {
                        puzzle_hash: PAYMENTS.commission.puzzle_hash,
                        amount: commission,
                        memos: Memos { value: [PAYMENTS.commission.puzzle_hash] },
                    },
                }
            },

            // Pay the auctioneer
            inline if payout > 0 {
                ReserveCondition {
                    condition: CreateCoin {
                        puzzle_hash: PAYMENTS.payout_puzzle_hash,
                        amount: payout,
                        memos: Memos { value: [PAYMENTS.payout_puzzle_hash] },
                    },
                }
            } else {
                Remark {}
            },

            // Fund an ephemeral settlement coin, which pays the NFT royalty that the NFT asserts.
            // The settlement puzzle can't make a payment of 0, so it's skipped if there's no royalty.
            inline if royalty == 0 {
                Remark {}
            } else {
                ReserveCondition {
                    condition: CreateCoin {
                        puzzle_hash: SETTLEMENT_PAYMENT_HASH,
                        amount: royalty,
                        memos: nil,
                    },
                }
            },

            // Authorize the NFT to be sent to the winning bidder
            SendMessage {
                mode: SENDER_PUZZLE | RECEIVER_COIN,
                receiver: [NFT_COIN_ID],
                message: tree_hash((1, unlock_conditions)),
            },

            // We always need to make sure the auction is over
            AssertSecondsAbsolute { seconds: TIMINGS.end_time },

            // Announce the end of the auction
            CreateCoinAnnouncement { message: "$" },

            // If there is a grace period, we need to make sure it's over too
            ...inline if TIMINGS.grace_period > 0 {
                [AssertSecondsRelative { seconds: TIMINGS.grace_period }]
            } else {
                nil
            },
        ],
    }
}
